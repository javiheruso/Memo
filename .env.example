MEMO_ENVIRONMENT=development
MEMO_DEBUG=false

# Minimal admin auth (optional): when set, the /admin UI requires a browser
# login (HMAC-signed session cookie) and /api/v1/admin requires the password as
# an `Authorization: Bearer <password>` header. Leave unset for fail-open local
# development and for the default test suite.
# MEMO_ADMIN_PASSWORD=

MEMO_DATABASE_URL=postgresql+psycopg://memo:memo@localhost:5432/memo

# Optional: run the test suite against a real PostgreSQL server instead of
# in-memory SQLite. Example:
# MEMO_TEST_DATABASE_URL=postgresql+psycopg://memo:memo@localhost:5432/memo_test

# Responder implementation selected by the chat pipeline.
# Known values: deterministic, openai_compatible
# MEMO_RESPONDER=deterministic
# MEMO_CLAIM_EXTRACTOR=deterministic
# MEMO_CLAIM_GROUPER=deterministic
# MEMO_CLAIM_CONTRADICTION_DETECTOR=deterministic

# Embedder implementation selected for semantic memory retrieval.
# Known values: deterministic, openai_compatible
# MEMO_EMBEDDER=deterministic
# MEMO_EMBEDDER_BASE_URL=https://api.openai.com/v1
# MEMO_EMBEDDER_API_KEY=
# MEMO_EMBEDDER_MODEL=text-embedding-3-small
# MEMO_EMBEDDER_TIMEOUT_SECONDS=30.0

# Real LLM responder (optional).
# MEMO_LLM_BASE_URL=https://api.openai.com/v1
# MEMO_LLM_API_KEY=
# MEMO_LLM_MODEL=gpt-4o-mini
# MEMO_LLM_TIMEOUT_SECONDS=30.0

# Voice layer (optional): speech-to-text and text-to-speech. Both default to
# empty, keeping the chat surface text-first with zero configuration. Leave
# unset to disable a feature; the /chat/voice endpoint then degrades to text.
# Known values: openai_compatible
# MEMO_STT=
# MEMO_STT_BASE_URL=https://api.openai.com/v1
# MEMO_STT_API_KEY=
# MEMO_STT_MODEL=whisper-1
# MEMO_STT_TIMEOUT_SECONDS=30.0
# MEMO_TTS=
# MEMO_TTS_BASE_URL=https://api.openai.com/v1
# MEMO_TTS_API_KEY=
# MEMO_TTS_MODEL=tts-1
# MEMO_TTS_VOICE=alloy
# MEMO_TTS_TIMEOUT_SECONDS=30.0

MEMO_API_V1_PREFIX=/api/v1
MEMO_CORS_ORIGINS=["http://localhost:3000"]
