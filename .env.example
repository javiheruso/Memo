MEMO_ENVIRONMENT=development
MEMO_DEBUG=false

# Minimal admin auth: when set, the /admin UI requires a browser login
# (HMAC-signed session cookie) and /api/v1/admin requires the password as an
# `Authorization: Bearer <password>` header. It is required outside development:
# startup fails if MEMO_ENVIRONMENT is not "development" and this is empty.
# Unset is only valid for fail-open local development and the default test suite.
# MEMO_ADMIN_PASSWORD=

# Dedicated signing secret for public chat-session cookies (memo_chat_session).
# Required outside development; startup fails when it is empty. Never reuse
# MEMO_ADMIN_PASSWORD. Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# MEMO_CHAT_SESSION_SECRET=
# Active key id embedded in new chat cookies. Change it when rotating the
# secret; old cookies are only accepted while their key id is listed below.
# MEMO_CHAT_SESSION_KEY_ID=v1
# Retired keys accepted during rotation, as a JSON object of key id -> secret.
# MEMO_CHAT_SESSION_PREVIOUS_KEYS={"v1":"old-secret"}

# Docker Compose requires POSTGRES_PASSWORD explicitly. `make db-up` supplies a
# local-only default; set a strong value for any shared or remote deployment.
# POSTGRES_PASSWORD=

# Host port for the Compose app; published on 127.0.0.1 only by default.
# APP_PORT=8000

# Host HTTPS port for the local Caddy reverse proxy; published on 127.0.0.1
# only. Open https://memo.localhost:8443 after trusting Caddy's local CA.
# CADDY_HTTPS_PORT=8443

# Apply `alembic upgrade head` automatically on startup (handy for
# zero-friction single-instance deploys like Railway and Render). The Docker
# entrypoint runs migrations before Uvicorn and disables the lifespan path so
# they are not applied twice. Defaults to false.
# MEMO_AUTO_MIGRATE=true

MEMO_DATABASE_URL=postgresql+psycopg://memo:memo@localhost:5432/memo

# Optional: run the test suite against a real PostgreSQL server instead of
# in-memory SQLite. Example:
# MEMO_TEST_DATABASE_URL=postgresql+psycopg://memo:memo@localhost:5432/memo_test

# Responder implementation selected by the chat pipeline.
# Known values: deterministic, openai_compatible
# MEMO_RESPONDER=deterministic
# MEMO_CLAIM_EXTRACTOR=deterministic
# MEMO_CLAIM_GROUPER=deterministic
# MEMO_CLAIM_CONTRADICTION_DETECTOR=deterministic

# Embedder implementation selected for semantic memory retrieval.
# Known values: deterministic, openai_compatible
# MEMO_EMBEDDER=deterministic
# MEMO_EMBEDDER_BASE_URL=https://api.openai.com/v1
# MEMO_EMBEDDER_API_KEY=
# MEMO_EMBEDDER_MODEL=text-embedding-3-small
# MEMO_EMBEDDER_TIMEOUT_SECONDS=30.0

# Real LLM responder (optional).
# MEMO_LLM_BASE_URL=https://api.openai.com/v1
# MEMO_LLM_API_KEY=
# MEMO_LLM_MODEL=gpt-4o-mini
# MEMO_LLM_TIMEOUT_SECONDS=30.0

# Optional low-confidence routing interpreter. Disabled by default. When
# enabled it reuses the LLM endpoint/key/model unless interpreter-specific
# values are set below. Bounds keep the extra provider call small.
# MEMO_INTERPRETER=
# MEMO_INTERPRETER_BASE_URL=
# MEMO_INTERPRETER_API_KEY=
# MEMO_INTERPRETER_MODEL=
# MEMO_INTERPRETER_TIMEOUT_SECONDS=10.0
# MEMO_INTERPRETER_HISTORY_TURNS=4
# MEMO_INTERPRETER_MAX_HISTORY_CHARS=1200
# MEMO_INTERPRETER_MAX_INPUT_CHARS=400

# Voice layer (optional): speech-to-text and text-to-speech. The public /chat
# page is voice-first when these are configured; without them it degrades to a
# clearly secondary text fallback. Leave unset to disable a feature.
# Known values: openai_compatible
# MEMO_STT=
# MEMO_STT_BASE_URL=https://api.openai.com/v1
# MEMO_STT_API_KEY=
# MEMO_STT_MODEL=whisper-1
# Spanish is the pilot default language hint sent to /audio/transcriptions.
# MEMO_STT_LANGUAGE=es
# MEMO_STT_TIMEOUT_SECONDS=30.0
# MEMO_TTS=
# MEMO_TTS_BASE_URL=https://api.openai.com/v1
# MEMO_TTS_API_KEY=
# MEMO_TTS_MODEL=tts-1
# MEMO_TTS_VOICE=alloy
# MEMO_TTS_TIMEOUT_SECONDS=30.0
# Application-level audio upload bound (bytes). The browser also stops
# recording after one minute; this limit protects the endpoint.
# MEMO_VOICE_MAX_AUDIO_BYTES=8388608

MEMO_API_V1_PREFIX=/api/v1
MEMO_CORS_ORIGINS=["http://localhost:3000"]
